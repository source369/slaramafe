{
  "version": 1,
  "paths": {
    "/slarama-api": {
      "name": "/slarama-api",
      "lambdaFunction": "slaramaLambda1",
      "permissions": {
        "setting": "private",
        "auth": [
          "create",
          "read",
          "update",
          "delete"
        ]
      }
    },
    "/slarama-crud": {
      "name": "/slarama-crud",
      "lambdaFunction": "slaramaCrud",
      "permissions": {
        "setting": "open"
      }
    },
    "/stay-request": {
      "name": "/stay-request",
      "lambdaFunction": "getStayRequestsLambda",
      "permissions": {
        "setting": "open"
      }
    },
    "/dashboard-data": {
      "name": "/dashboard-data",
      "lambdaFunction": "dashboardDataLambda",
      "permissions": {
        "setting": "open"
      }
    },
    "/login": {
      "name": "/login",
      "lambdaFunction": "loginLambda",
      "permissions": {
        "setting": "open"
      }
    },
    "/register-monk": {
      "name": "/register-monk",
      "lambdaFunction": "registerMonkLambda",
      "permissions": {
        "setting": "open"
      }
    }
  }
}